{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "jsx": "react-jsx"
  },
  "include": [
    "src/agent/**/*.ts",
    "src/runtime/**/*.ts",
    "src/server/**/*.ts",
    "src/terminal/**/*.ts",
    "src/terminal/**/*.tsx"
  ]
}
