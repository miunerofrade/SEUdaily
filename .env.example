DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
TAVILY_API_KEY=
SEUDAILY_PROJECT_ROOT=
SEUDAILY_OBSERVATIONAL_MEMORY=true
SEUDAILY_CONTEXT_WINDOW_TOKENS=512000
SEUDAILY_OBSERVATION_COMPRESSION_RATIO=0.8
SEUDAILY_MEMORY_LAST_MESSAGES=200
SEUDAILY_PREVIOUS_OBSERVER_TOKENS=1500
SEUDAILY_WORKSPACE_COMMAND_TIMEOUT_MS=120000
SEUDAILY_WSL_SANDBOX=true
SEUDAILY_WSL_DISTRO=Ubuntu-24.04
SEUDAILY_SANDBOX_NETWORK=false

SEUDAILY_USERNAME=
SEUDAILY_PASSWORD=
SEUDAILY_ASR_API_KEY=
SEUDAILY_BROWSER=auto

# Optional: use an installed zju-connect instead of downloading the pinned official release
SEUDAILY_VPN_BINARY=
SEUDAILY_VPN_DNS_SERVER=202.119.24.12

# Knowledge base embeddings and reranking share one Alibaba Cloud API Key (Beijing)
DASHSCOPE_API_KEY=
SEUDAILY_EMBEDDING_MODEL=qwen3.7-text-embedding
SEUDAILY_RERANK_MODEL=qwen3.7-text-rerank
SEUDAILY_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
